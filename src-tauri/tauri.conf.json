{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Briar",
  "version": "0.1.0",
  "identifier": "app.briar.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Briar",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 22 },
        "backgroundColor": "#08090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8787 https:; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Agent Development Environment",
    "longDescription": "Connect local agents and observe Auto Hunt progress from a desktop dashboard.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
