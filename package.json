{
  "name": "briar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "briar": "src-cli/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "cli": "bun run src-cli/index.ts",
    "cli:build": "bun build src-cli/index.ts --target=bun --outfile dist-cli/briar.js",
    "cli:install": "bun run cli:build && sh scripts/install-cli.sh",
    "d1:migrate:local": "wrangler d1 migrations apply briar-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply briar-db --remote",
    "secrets:check": "dotenvx run --strict --overload -f .env.production -- bun run scripts/with-worker-secrets.ts check",
    "worker:dev": "dotenvx run --strict --overload -f .env.production -- bun run scripts/with-worker-secrets.ts dev",
    "worker:types": "wrangler types worker-configuration.d.ts",
    "worker:check": "tsc --project worker/tsconfig.json",
    "worker:build": "wrangler deploy --dry-run --outdir dist-worker",
    "worker:deploy": "dotenvx run --strict --overload -f .env.production -- bun run scripts/with-worker-secrets.ts deploy",
    "worker:startup": "wrangler check startup"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "better-auth": "1.6.23",
    "lucide-react": "0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260721.1",
    "@dotenvx/dotenvx": "^2.15.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.3.8",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "27.4.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.0",
    "wrangler": "4.112.0"
  }
}
