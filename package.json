{
  "name": "briar",
  "version": "1.2.108",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "briar": "src-cli/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "bash scripts/dev-all.sh",
    "build": "bun run runtime:prepare && bun run skills:check && tsc --noEmit && vite build && bun run agent:build",
    "web:build": "bash scripts/with-release-env.sh env VITE_BRIAR_WEB=true vite build",
    "build:release": "bash scripts/with-release-env.sh bun run build && bash scripts/verify-release-config.sh",
    "check": "bun run skills:check && tsc --noEmit",
    "test": "vitest run",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:signoff": "bash scripts/ci-local.sh --signoff",
    "mobile:contract": "vitest run worker/src/mobile-contract.test.ts",
    "mobile:ci": "bash scripts/ci-mobile.sh",
    "ios:native:project": "xcodegen generate --spec ios/BriarCompanion/project.yml --project ios/BriarCompanion",
    "ios:native:test": "xcodebuild -project ios/BriarCompanion/BriarCompanion.xcodeproj -scheme BriarCompanion-Dev -destination 'platform=iOS Simulator,name=Briar iPhone 17 Pro' CODE_SIGNING_ALLOWED=NO test",
    "ios:release:verify": "bun run scripts/ios-release-config.ts verify",
    "ios:release": "bash scripts/release-ios.sh",
    "release:macos:candidate": "bash scripts/release-macos-candidate.sh",
    "release:macos:production": "bash scripts/release-macos-production.sh",
    "qa:release-updater": "bash scripts/qa-production-updater-build.sh",
    "tauri": "tauri",
    "tauri:build:release": "bash scripts/with-release-env.sh bun run tauri build && bash scripts/verify-release-config.sh",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --aab --ci",
    "android:build:debug": "tauri android build --debug --apk --target aarch64 --split-per-abi --ci",
    "cli": "bun run src-cli/index.ts",
    "cli:build": "bun run skills:generate && bun build src-cli/index.ts --target=bun --outfile dist-cli/briar.js",
    "cli:install": "bun run cli:build && sh scripts/install-cli.sh",
    "agent:build": "bun build src-agent/claude-runner.ts --target=bun --outfile dist-agent/claude-runner.js && bun build src-agent/grok-runner.ts --target=bun --outfile dist-agent/grok-runner.js && bun build src-agent/opencode-runner.ts --target=bun --outfile dist-agent/opencode-runner.js && bun build src-agent/codex-runner.ts --target=bun --outfile dist-agent/codex-runner.js",
    "runtime:prepare": "bun run scripts/prepare-bun-sidecar.ts",
    "skills:generate": "bun run scripts/generate-skill-guides.ts",
    "skills:check": "bun run scripts/generate-skill-guides.ts --check",
    "d1:migrate:local": "wrangler d1 migrations apply briar-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply briar-db --remote",
    "audit:dependencies": "bash scripts/audit-dependencies.sh",
    "audit:rust": "bash scripts/audit-rust-dependencies.sh",
    "secrets:verify-encrypted": "bun run scripts/verify-encrypted-env.ts",
    "secrets:check": "dotenvx run --strict --overload -f .env.production -- bun run scripts/with-worker-secrets.ts check",
    "worker:dev": "dotenvx run --strict --overload -f .env.production -- bun run scripts/with-worker-secrets.ts dev",
    "worker:types": "wrangler types worker-configuration.d.ts",
    "worker:check": "tsc --project worker/tsconfig.json",
    "worker:build": "bun run web:build && wrangler deploy --dry-run --outdir dist-worker",
    "worker:deploy": "bun run web:build && dotenvx run --strict --overload -f .env.production -- bun run scripts/with-worker-secrets.ts deploy",
    "worker:startup": "wrangler check startup"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@opencode-ai/sdk": "^1.3.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emoji-mart": "^5.6.0",
    "lucide-react": "0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260721.1",
    "@dotenvx/dotenvx": "^2.15.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.3.8",
    "@types/emoji-mart": "^5.3.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "27.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.4.0",
    "nanoid": "3.3.17",
    "postcss": "8.5.23",
    "undici": "7.29.0"
  }
}
