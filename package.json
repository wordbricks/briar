{
  "name": "briar",
  "version": "1.2.177",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "@bufbuild/protobuf": "2.14.0",
      "@cloudflare/vitest-plugin": "1.1.1",
      "@cloudflare/workers-types": "5.20260721.1",
      "@connectrpc/connect": "2.1.2",
      "@connectrpc/connect-web": "2.1.2",
      "@dotenvx/dotenvx": "2.19.2",
      "@effect/eslint-plugin": "0.3.2",
      "@effect/tsgo": "0.36.5",
      "@oxlint/plugins": "1.80.0",
      "@types/bun": "1.4.0",
      "@types/node": "24.10.1",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@vitejs/plugin-react": "6.0.2",
      "effect": "4.0.0-rc.112",
      "oxlint": "1.80.0",
      "oxlint-tsgolint": "7.0.2001",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "vite": "8.0.16",
      "vitest": "4.1.0",
      "wrangler": "4.125.0"
    }
  },
  "bin": {
    "briar": "apps/briar/src-cli/index.ts"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@briar/app",
    "dev:all": "bash scripts/dev-all.sh",
    "dev:workspace": "turbo run dev",
    "build": "turbo run build",
    "web:build": "turbo run web:build --filter=@briar/app",
    "build:release": "turbo run build:release --filter=@briar/app",
    "check": "turbo run lint lint:type-aware typecheck skills:check //#lint:repo //#lint:repo:type-aware",
    "lint": "turbo run lint //#lint:repo",
    "lint:repo": "oxlint scripts --config .oxlintrc.jsonc",
    "lint:type-aware": "turbo run lint:type-aware //#lint:repo:type-aware",
    "lint:repo:type-aware": "oxlint --type-aware scripts --config .oxlintrc.jsonc",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test //#test:repo-tools",
    "test:repo-tools": "vitest run --maxWorkers=1 --no-file-parallelism scripts/apply-remote-d1-migrations.test.ts scripts/ios-release-config.test.ts scripts/macos-dmg-release.test.ts scripts/verify-encrypted-env.test.ts tools/oxlint/anti-slop/rules/no-raw-tauri-ipc.test.ts",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:signoff": "bash scripts/ci-local.sh --signoff",
    "contracts:generate": "bash scripts/generate-contracts.sh",
    "contracts:check": "bash scripts/check-contracts.sh",
    "mobile:ci": "bash scripts/ci-mobile.sh",
    "ios:bootstrap": "bash scripts/ios-simulator.sh bootstrap",
    "ios:native:project": "turbo run ios:native:project --filter=@briar/app",
    "ios:native:build-for-testing": "bash scripts/ios-simulator.sh build-for-testing",
    "ios:native:test": "turbo run ios:native:test --filter=@briar/app",
    "ios:release:verify": "turbo run ios:release:verify --filter=@briar/app",
    "ios:release": "bash scripts/release-ios.sh",
    "release:macos:candidate": "bash scripts/release-macos-candidate.sh",
    "release:macos:production": "bash scripts/release-macos-production.sh",
    "qa:release-updater": "turbo run qa:release-updater --filter=@briar/app",
    "tauri": "bun --cwd apps/briar tauri",
    "tauri:build:release": "turbo run tauri:build:release --filter=@briar/app",
    "android:init": "turbo run android:init --filter=@briar/app",
    "android:dev": "turbo run android:dev --filter=@briar/app",
    "android:build": "turbo run android:build --filter=@briar/app",
    "android:build:debug": "turbo run android:build:debug --filter=@briar/app",
    "cli": "bun run apps/briar/src-cli/index.ts",
    "cli:build": "turbo run cli:build --filter=@briar/app",
    "cli:install": "turbo run cli:install --filter=@briar/app",
    "agent:build": "turbo run agent:build --filter=@briar/app",
    "runtime:prepare": "turbo run runtime:prepare --filter=@briar/app",
    "skills:generate": "turbo run skills:generate --filter=@briar/app",
    "skills:check": "turbo run skills:check --filter=@briar/app",
    "d1:migrate:local": "turbo run d1:migrate:local --filter=@briar/app --",
    "d1:migrate:remote": "turbo run d1:migrate:remote --filter=@briar/app",
    "test:d1:migrations": "turbo run test:d1:migrations --filter=@briar/app",
    "audit:dependencies": "bash scripts/audit-dependencies.sh",
    "audit:rust": "bash scripts/audit-rust-dependencies.sh",
    "secrets:verify-encrypted": "turbo run secrets:verify-encrypted --filter=@briar/app",
    "secrets:check": "turbo run secrets:check --filter=@briar/app",
    "worker:dev": "turbo run worker:dev --filter=@briar/app",
    "worker:types": "turbo run worker:types --filter=@briar/app",
    "worker:check": "turbo run worker:check --filter=@briar/app",
    "worker:build": "turbo run worker:build --filter=@briar/app",
    "worker:deploy": "turbo run worker:deploy --filter=@briar/app",
    "worker:startup": "turbo run worker:startup --filter=@briar/app",
    "managed-computer:image:check": "bun run scripts/validate-managed-computer-image.ts",
    "managed-computer:runtime-updater:check": "bash scripts/qa-managed-runtime-updater.sh",
    "managed-computer:image:build": "infrastructure/managed-computers/build-managed-computer-image"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@effect/eslint-plugin": "catalog:",
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/utils": "8.22.0",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "2.10.9",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@hono/node-server": "2.0.12",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.4.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "undici": "7.29.0"
  }
}
