{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "ignoreEffectSuggestionsInTscExitCode": false,
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "cryptoRandomUUIDInEffect": "warning",
          "deterministicKeys": "suggestion",
          "effectDoNotation": "suggestion",
          "globalConsoleInEffect": "warning",
          "globalDateInEffect": "warning",
          "globalFetchInEffect": "warning",
          "globalRandomInEffect": "warning",
          "globalTimersInEffect": "warning",
          "instanceOfSchema": "warning",
          "nestedEffectGenYield": "suggestion",
          "preferSchemaTypeProperty": "suggestion",
          "processEnvInEffect": "warning",
          "schemaUnionOfLiterals": "suggestion",
          "serviceNotAsClass": "suggestion",
          "unnecessaryArrowBlock": "suggestion",
          "unsafeEffectTypeAssertion": "error"
          // Not enabled: strictBooleanExpressions requires a dedicated migration
          // of existing React, DTO, and SDK-boundary truthiness checks.
          // Not enabled: newPromise also reports legitimate browser, event, SDK,
          // and test Promise bridges that are not owned by an Effect workflow.
          // Not enabled: extendsNativeError covers established boundary error
          // contracts whose migration needs runtime and serialization review.
        },
        "overrides": [
          {
            "include": [
              "../../apps/**/*.test.ts",
              "../../apps/**/*.test.tsx"
            ],
            "options": {
              "diagnosticSeverity": {
                "anyUnknownInErrorContext": "off"
              }
            }
          }
        ]
      }
    ]
  }
}
