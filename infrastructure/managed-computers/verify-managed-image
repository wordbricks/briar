#!/usr/bin/env bash
set -euo pipefail

capture_ready=false
if [[ "${1:-}" == "--capture-ready" ]]; then
  capture_ready=true
elif [[ $# -gt 0 ]]; then
  echo "Usage: verify-managed-image [--capture-ready]" >&2
  exit 2
fi

/opt/briar/bin/assert-debian-13-x86_64

# shellcheck disable=SC1091
. /opt/briar/image-lock.env
briar_version="$(tr -d '\r\n' < /opt/briar/briar-version)"
export HOME="${HOME:-/root}"
export CARGO_HOME=/opt/briar/cargo
export RUSTUP_HOME=/opt/briar/rustup
export PATH=/opt/briar/bin:/usr/local/bin:/usr/bin:/bin

test "$(/opt/briar/bin/bun --version)" = "$BUN_VERSION"
test "$(/opt/briar/bin/bunx --version)" = "$BUN_VERSION"
test "$(/opt/briar/bin/node --version)" = "v$NODE_VERSION"
test "$(/opt/briar/bin/rustc --version | awk '{print $2}')" = \
  "$RUST_TOOLCHAIN_VERSION"
test "$(/opt/briar/bin/cargo-audit --version)" = \
  "cargo-audit $CARGO_AUDIT_VERSION"
test "$(/opt/briar/bin/gitleaks version)" = "$GITLEAKS_VERSION"
test "$(/opt/briar/bin/briar version)" = "briar $briar_version"
test "$(dpkg-query --show --showformat='${Version}' google-chrome-stable)" = \
  "$GOOGLE_CHROME_VERSION"
test "$(dpkg-query --show --showformat='${Version}' amazon-ssm-agent)" = \
  "$SSM_AGENT_PACKAGE_VERSION"

codex_version_output="$(sudo -u briar -H /opt/briar/bin/codex --version 2>&1)"
grep -Fq "$CODEX_CLI_VERSION" <<< "$codex_version_output"
if grep -Fq "could not create PATH aliases" <<< "$codex_version_output"; then
  echo "Codex cannot write temporary helper aliases as the managed user" >&2
  exit 1
fi
/opt/briar/bin/claude --version | grep -Fq "$CLAUDE_CODE_VERSION"
/opt/briar/bin/agent-browser --version | grep -Fq "$AGENT_BROWSER_VERSION"
/opt/briar/bin/velen --version | grep -Fq "$VELEN_CLI_VERSION"
/opt/briar/bin/opencode --version | grep -Fxq "$OPENCODE_CLI_VERSION"
/opt/briar/bin/grok --version | grep -Fq "grok $GROK_CLI_VERSION"
/opt/briar/bin/cursor-agent --version | grep -Fxq "$CURSOR_AGENT_VERSION"
/opt/briar/bin/agy --version | grep -Fxq "$ANTIGRAVITY_CLI_VERSION"
command -v git >/dev/null
command -v script >/dev/null
command -v setsid >/dev/null
command -v xfdesktop >/dev/null
command -v node >/dev/null
command -v cc >/dev/null
command -v make >/dev/null
command -v minisign >/dev/null
command -v pkg-config >/dev/null
pkg-config --exists openssl
pkg-config --exists webkit2gtk-4.1
pkg-config --exists ayatana-appindicator3-0.1
test -x /usr/bin/google-chrome-stable
test -x /opt/briar/bin/briar-open-browser
grep -Fq -- '--no-first-run' /opt/briar/bin/briar-open-browser
grep -Fq -- '--no-default-browser-check' /opt/briar/bin/briar-open-browser
test -r /usr/share/applications/google-chrome.desktop
grep -Fq 'Icon=google-chrome' /usr/share/applications/google-chrome.desktop
test -x "/home/briar/Desktop/Google Chrome.desktop"
grep -Fq 'google-chrome.desktop' /home/briar/.config/mimeapps.list
grep -Fq 'FontName=Noto Sans Mono CJK KR 12' \
  /home/briar/.config/xfce4/terminal/terminalrc
fc-match -f '%{family}\n' ':lang=ko' | grep -Fq 'Noto Sans CJK KR'

for binary in \
  bun bunx node cargo rustc rustfmt cargo-audit gitleaks \
  briar codex claude agent-browser velen opencode grok cursor-agent agy; do
  test "$(sudo -u briar -H bash -lc "command -v $binary")" = \
    "/opt/briar/bin/$binary"
done
test "$(sudo -u briar -H bash -lc 'printf %s "$CARGO_HOME"')" = \
  "/home/briar/.cargo"
test "$(sudo -u briar -H bash -lc 'printf %s "$RUSTUP_HOME"')" = \
  "/home/briar/.rustup"
script_help="$(script --help)"
for required_flag in --command --echo --flush --return; do
  grep -Fq -- "$required_flag" <<< "$script_help"
done
sudo -u briar -H test -w /home/briar/.cargo
sudo -u briar -H test -w /home/briar/.rustup/downloads
sudo -u briar -H test -w /home/briar/.rustup/tmp
sudo -u briar -H test -w /home/briar/.codex
sudo -u briar -H test -w /home/briar/.codex/log
sudo -u briar -H bash -lc 'rustup run 1.96.0 rustc --version' \
  | grep -Fq "rustc $RUST_TOOLCHAIN_VERSION "

runner_count="$(find /opt/briar/lib/agent -maxdepth 1 -type f \
  -name '*-runner.js' | wc -l)"
test "$runner_count" = "6"
test "$(readlink -f /opt/briar/current)" = \
  "/opt/briar/releases/$briar_version"
test "$(readlink -f /opt/briar/bin/briar)" = \
  "/opt/briar/releases/$briar_version/bin/briar"
test -x /opt/briar/bin/briar-managed-runtime-update-request
test -x /opt/briar/bin/briar-managed-runtime-updater
test -s /opt/briar/etc/runtime-updater.pub
jq -e \
  --arg version "$briar_version" \
  '.schemaVersion == 1 and .version == $version and
   .platform == "linux-x86_64"' \
  /opt/briar/current/manifest.json >/dev/null
for skill_root in \
  /home/briar/.codex/skills \
  /home/briar/.claude/skills \
  /home/briar/.cursor/skills \
  /home/briar/.grok/skills \
  /home/briar/.gemini/config/skills \
  /home/briar/.config/opencode/skills; do
  for skill_name in briar-workflow browser; do
    test "$(readlink "$skill_root/$skill_name")" = \
      "/opt/briar/current/skills/$skill_name"
    test "$(tr -d '\r\n' < "$skill_root/$skill_name/VERSION")" = \
      "$briar_version"
  done
done

verify_skill_only_provider_root() {
  local provider_root="$1"
  local skill_subdirectory="$2"
  local entry relative target

  while IFS= read -r -d '' entry; do
    relative="${entry#"$provider_root/"}"
    if [[ -d "$entry" && ! -L "$entry" &&
      ( "$skill_subdirectory" == "$relative" ||
        "$skill_subdirectory" == "$relative/"* ) ]]; then
      continue
    fi
    case "$relative" in
      "$skill_subdirectory/briar-workflow")
        target=/opt/briar/current/skills/briar-workflow
        ;;
      "$skill_subdirectory/browser")
        target=/opt/briar/current/skills/browser
        ;;
      *)
        echo "Image contains forbidden provider runtime state: $entry" >&2
        return 1
        ;;
    esac
    if [[ ! -L "$entry" || "$(readlink "$entry")" != "$target" ]]; then
      echo "Image contains an unexpected provider skill link: $entry" >&2
      return 1
    fi
  done < <(find "$provider_root" -mindepth 1 -print0)
}

verify_skill_only_provider_root /home/briar/.cursor skills
verify_skill_only_provider_root /home/briar/.grok skills
verify_skill_only_provider_root /home/briar/.gemini config/skills

sha256sum --check /opt/briar/remote-desktop-packages.lock.sha256
sha256sum --check /opt/briar/debian-packages.lock.sha256
sha256sum --check /opt/briar/provider/bun.lock.sha256
jq -e \
  --arg sourceCommit "$(tr -d '\r\n' < /opt/briar/source-commit)" \
  --arg baseAmiId "${BRIAR_BASE_AMI_ID:-$(jq -r .baseAmiId /opt/briar/image-manifest.json)}" \
  --arg nodeVersion "$NODE_VERSION" \
  --arg rustVersion "$RUST_TOOLCHAIN_VERSION" \
  --arg velenVersion "$VELEN_CLI_VERSION" \
  --arg opencodeVersion "$OPENCODE_CLI_VERSION" \
  --arg grokVersion "$GROK_CLI_VERSION" \
  --arg cursorVersion "$CURSOR_AGENT_VERSION" \
  --arg antigravityVersion "$ANTIGRAVITY_CLI_VERSION" \
  '.schemaVersion == 2 and .sourceCommit == $sourceCommit and
   .baseAmiId == $baseAmiId and .runtime.googleChrome != "" and
   .runtime.node == $nodeVersion and .runtime.rust == $rustVersion and
   .runtime.velen == $velenVersion and
   .runtime.providers.opencode == $opencodeVersion and
   .runtime.providers.grok == $grokVersion and
   .runtime.providers.cursor == $cursorVersion and
   .runtime.providers.antigravity == $antigravityVersion' \
  /opt/briar/image-manifest.json >/dev/null

for service in \
  amazon-ssm-agent.service \
  briar-managed-computer.target \
  briar-managed-computer-health.timer; do
  systemctl is-enabled --quiet "$service"
done
test "$(systemctl show briar-managed-worker.service --property=User --value)" = \
  "briar"
test "$(systemctl show briar-managed-worker.service --property=Group --value)" = \
  "briar"
test "$(systemctl show briar-managed-runtime-updater.service --property=User --value)" = \
  "root"
systemctl show briar-managed-worker.service --property=Environment --value \
  | grep -Fq 'CARGO_HOME=/home/briar/.cargo'
systemctl show briar-managed-worker.service --property=Environment --value \
  | grep -Fq 'RUSTUP_HOME=/home/briar/.rustup'
systemctl show briar-managed-worker.service --property=Environment --value \
  | grep -Fq 'BRIAR_MANAGED_RUNTIME_UPDATER=/opt/briar/bin/briar-managed-runtime-update-request'
systemctl show briar-remote-session-agent.service --property=Environment --value \
  | grep -Fq 'PATH=/opt/briar/bin:'
systemctl show briar-remote-session-agent.service --property=ReadWritePaths --value \
  | grep -Fq '/home/briar'
if systemctl cat briar-managed-worker.service | grep -q 'briar_worker_'; then
  echo "Managed worker unit contains credential material" >&2
  exit 1
fi
systemd-analyze verify \
  /etc/systemd/system/briar-managed-computer.target \
  /etc/systemd/system/briar-managed-computer-health.service \
  /etc/systemd/system/briar-managed-computer-health.timer \
  /etc/systemd/system/briar-managed-enroll.service \
  /etc/systemd/system/briar-managed-runtime-updater.service \
  /etc/systemd/system/briar-managed-worker.service \
  /etc/systemd/system/briar-remote-desktop.service \
  /etc/systemd/system/briar-remote-session-agent.service

for forbidden in \
  /var/lib/briar/worker-credential.json \
  /var/lib/briar/managed-enrollment.json \
  /home/briar/.config/briar/config.json \
  /home/briar/.codex/auth.json \
  /home/briar/.claude/.credentials.json \
  /home/briar/.local/share/opencode/auth.json \
  /var/lib/amazon/ssm/credentials \
  /var/lib/amazon/ssm/registration; do
  if [[ -e "$forbidden" ]]; then
    echo "Image contains forbidden runtime state: $forbidden" >&2
    exit 1
  fi
done
if find /opt/briar -type f \( -name '.env' -o -name '.env.*' \) \
  -print -quit | grep -q .; then
  echo "Image contains an environment credential file" >&2
  exit 1
fi
if [[ "$capture_ready" == true ]]; then
  for forbidden in \
    /home/admin/.ssh \
    /root/.ssh \
    /root/.aws \
    /home/admin/.aws \
    /home/briar/.aws \
    /home/briar/.ssh \
    /home/briar/.git-credentials \
    /home/briar/.config/gh \
    /home/briar/.npmrc \
    /root/.npmrc; do
    if [[ -e "$forbidden" ]]; then
      echo "Image contains forbidden build or user authentication state: $forbidden" >&2
      exit 1
    fi
  done
fi

echo "managed computer image verification passed"
