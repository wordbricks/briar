#!/usr/bin/env bash
set -euo pipefail

/opt/briar/bin/assert-debian-13-x86_64

expected_user="${BRIAR_REMOTE_USER:-briar}"
expected_port="${BRIAR_REMOTE_DISPLAY_PORT:-5901}"

test "$(stat -c '%U:%G' /home/briar)" == "$expected_user:$expected_user"
test "$(stat -c '%U:%G %a' /var/lib/briar)" == "root:$expected_user 750"
test -s /opt/briar/remote-desktop-packages.lock
sha256sum --check /opt/briar/remote-desktop-packages.lock.sha256

for service in \
  briar-managed-computer.target \
  briar-managed-computer-health.timer; do
  systemctl is-enabled --quiet "$service"
done

for service in \
  briar-managed-computer.target \
  briar-managed-computer-health.timer \
  briar-managed-enroll.service \
  briar-managed-runtime-updater.service \
  briar-managed-worker.service \
  briar-remote-desktop.service \
  briar-remote-session-agent.service; do
  systemctl is-active --quiet "$service"
done

mapfile -t listener_addresses < <(
  ss -H -ltn "sport = :${expected_port}" | awk '{print $4}'
)
if ((${#listener_addresses[@]} == 0)); then
  echo "Remote display is not listening on port $expected_port" >&2
  exit 1
fi
for listener_address in "${listener_addresses[@]}"; do
  case "$listener_address" in
    "127.0.0.1:${expected_port}" | "[::1]:${expected_port}") ;;
    *)
      echo "Remote display has a non-loopback listener: $listener_address" >&2
      exit 1
      ;;
  esac
done

if systemctl show briar-remote-desktop.service \
  --property=User --value | grep -Fxq root; then
  echo "Remote desktop must not run as root" >&2
  exit 1
fi
if systemctl show briar-remote-session-agent.service \
  --property=User --value | grep -Fxq root; then
  echo "Remote session agent must not run as root" >&2
  exit 1
fi
if systemctl show briar-managed-worker.service \
  --property=User --value | grep -Fxq root; then
  echo "Managed worker must not run as root" >&2
  exit 1
fi
if systemctl cat briar-managed-worker.service | grep -q 'briar_worker_'; then
  echo "Managed worker unit must not contain a machine credential" >&2
  exit 1
fi

echo "remote desktop verification passed"
