#!/bin/sh
set -eu

if [ "$#" -gt 1 ]; then
  echo "Usage: briar-open-browser [url]" >&2
  exit 2
fi

url="${1:-https://www.google.com/}"
case "$url" in
  http://*|https://*) ;;
  *)
    echo "briar-open-browser requires an HTTP(S) URL" >&2
    exit 2
    ;;
esac

profile_directory="${BRIAR_BROWSER_PROFILE_DIRECTORY:-}"
if [ -n "$profile_directory" ]; then
  case "$profile_directory" in
    # display-1 is the owner's own desktop, the login source for the shared
    # store; display-2 and above are the Agent windows.
    /var/lib/briar-computer-use/profiles/display-1|\
    /var/lib/briar-computer-use/profiles/display-[2-9]|\
    /var/lib/briar-computer-use/profiles/display-[1-9][0-9]|\
    /var/lib/briar-computer-use/profiles/display-100) ;;
    *)
      echo "BRIAR_BROWSER_PROFILE_DIRECTORY is not an assigned Computer Use profile" >&2
      exit 2
      ;;
  esac
  /usr/bin/install -d -m 0700 "$profile_directory"
  # The shared login store moves cookies and saved passwords between display
  # profiles, so the encryption key must not depend on a per-session keyring.
  set -- --user-data-dir="$profile_directory" --password-store=basic
else
  set --
fi

/usr/bin/nohup /usr/bin/setsid --fork \
  /usr/bin/google-chrome-stable \
  --no-first-run \
  --no-default-browser-check \
  "$@" \
  --new-window "$url" \
  </dev/null >/dev/null 2>&1 &
