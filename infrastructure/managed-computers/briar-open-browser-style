#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo "Usage: briar-open-browser-style <url>" >&2
  exit 2
fi

url="$1"
case "$url" in
  http://*|https://*) ;;
  *)
    echo "briar-open-browser-style requires an HTTP(S) URL" >&2
    exit 2
    ;;
esac

umask 077
log_directory=/home/briar/.local/state/briar
log_file="$log_directory/google-chrome.log"
mkdir -p "$log_directory"
chmod 0700 "$log_directory"

/usr/bin/nohup /usr/bin/setsid --fork \
  /usr/bin/google-chrome-stable --new-window "$url" \
  </dev/null >>"$log_file" 2>&1 &
