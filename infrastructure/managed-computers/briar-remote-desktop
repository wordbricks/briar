#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -u)" == "0" ]]; then
  echo "briar-remote-desktop must run as the unprivileged briar user" >&2
  exit 1
fi

display_number="${BRIAR_REMOTE_DISPLAY_NUMBER:-1}"
geometry="${BRIAR_REMOTE_DISPLAY_GEOMETRY:-1280x720}"
rfb_port="${BRIAR_REMOTE_DISPLAY_PORT:-5901}"
desktop_name="${BRIAR_REMOTE_DISPLAY_NAME:-Briar managed computer}"
startup_timeout_seconds="${BRIAR_REMOTE_DISPLAY_STARTUP_TIMEOUT_SECONDS:-120}"
display=":${display_number}"

if ! [[ "$display_number" =~ ^[1-9][0-9]*$ ]]; then
  echo "BRIAR_REMOTE_DISPLAY_NUMBER must be a positive integer" >&2
  exit 1
fi
if ! [[ "$rfb_port" =~ ^[1-9][0-9]*$ ]] || ((rfb_port > 65535)); then
  echo "BRIAR_REMOTE_DISPLAY_PORT must be a valid TCP port" >&2
  exit 1
fi
if ! [[ "$geometry" =~ ^[1-9][0-9]*x[1-9][0-9]*$ ]]; then
  echo "BRIAR_REMOTE_DISPLAY_GEOMETRY must be WIDTHxHEIGHT" >&2
  exit 1
fi
if ! [[ "$startup_timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
  echo "BRIAR_REMOTE_DISPLAY_STARTUP_TIMEOUT_SECONDS must be a positive integer" >&2
  exit 1
fi

cleanup() {
  if [[ -n "${vnc_pid:-}" ]]; then
    kill "$vnc_pid" 2>/dev/null || true
    wait "$vnc_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

rm -f "/tmp/.X${display_number}-lock" "/tmp/.X11-unix/X${display_number}"
/usr/bin/Xtigervnc "$display" \
  -localhost \
  -geometry "$geometry" \
  -SecurityTypes None \
  -rfbport "$rfb_port" \
  -desktop "$desktop_name" &
vnc_pid=$!

startup_deadline=$((SECONDS + startup_timeout_seconds))
while ((SECONDS < startup_deadline)); do
  if /usr/bin/ss -ltn "sport = :${rfb_port}" | grep -q "127.0.0.1:${rfb_port}"; then
    break
  fi
  if ! kill -0 "$vnc_pid" 2>/dev/null; then
    wait "$vnc_pid"
  fi
  sleep 0.2
done
if ! /usr/bin/ss -ltn "sport = :${rfb_port}" |
  grep -q "127.0.0.1:${rfb_port}"; then
  echo "TigerVNC did not bind to loopback port ${rfb_port}" >&2
  exit 1
fi

export DISPLAY="$display"
unset DBUS_SESSION_BUS_ADDRESS
unset SESSION_MANAGER
exec /usr/bin/dbus-run-session -- /usr/bin/xfce4-session
