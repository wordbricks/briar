#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -u)" == "0" ]]; then
  echo "briar-remote-desktop must run as the unprivileged briar user" >&2
  exit 1
fi

display_number="${BRIAR_REMOTE_DISPLAY_NUMBER:-1}"
geometry="${BRIAR_REMOTE_DISPLAY_GEOMETRY:-1280x720}"
rfb_port="${BRIAR_REMOTE_DISPLAY_PORT:-5901}"
display=":${display_number}"

cleanup() {
  if [[ -n "${vnc_pid:-}" ]]; then
    kill "$vnc_pid" 2>/dev/null || true
    wait "$vnc_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

rm -f "/tmp/.X${display_number}-lock" "/tmp/.X11-unix/X${display_number}"
/usr/bin/Xtigervnc "$display" \
  -fg \
  -localhost \
  -geometry "$geometry" \
  -SecurityTypes None \
  -rfbport "$rfb_port" \
  -desktop "Briar managed computer" &
vnc_pid=$!

for _ in {1..100}; do
  if /usr/bin/ss -ltn "sport = :${rfb_port}" | grep -q "127.0.0.1:${rfb_port}"; then
    break
  fi
  if ! kill -0 "$vnc_pid" 2>/dev/null; then
    wait "$vnc_pid"
  fi
  sleep 0.1
done
if ! /usr/bin/ss -ltn "sport = :${rfb_port}" |
  grep -q "127.0.0.1:${rfb_port}"; then
  echo "TigerVNC did not bind to loopback port ${rfb_port}" >&2
  exit 1
fi

export DISPLAY="$display"
unset DBUS_SESSION_BUS_ADDRESS
exec /usr/bin/dbus-run-session -- /usr/bin/xfce4-session
