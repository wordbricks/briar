#!/usr/bin/env bash
set -euo pipefail

state_dir=/var/lib/briar
config_file="$state_dir/managed-enrollment.json"
identity_file="$state_dir/instance-identity.json"
signature_file="$state_dir/instance-identity-signature"
credential_file="$state_dir/worker-credential.json"

if [[ ! -e "$config_file" && -s "$credential_file" ]]; then
  if [[ "$(stat -c '%U:%G %a' "$credential_file")" != "root:briar 640" ]]; then
    echo "Existing Briar credential has unsafe ownership or mode" >&2
    exit 1
  fi
  exit 0
fi
test -r "$config_file"
install -d -m 0700 "$state_dir"

imds_token="$(curl --fail --silent --show-error --request PUT \
  --header 'X-aws-ec2-metadata-token-ttl-seconds: 300' \
  http://169.254.169.254/latest/api/token)"
curl --fail --silent --show-error \
  --header "X-aws-ec2-metadata-token: $imds_token" \
  http://169.254.169.254/latest/dynamic/instance-identity/document \
  > "$identity_file"
curl --fail --silent --show-error \
  --header "X-aws-ec2-metadata-token: $imds_token" \
  http://169.254.169.254/latest/dynamic/instance-identity/signature \
  > "$signature_file"
unset imds_token
chmod 0600 "$config_file" "$identity_file" "$signature_file"

# JavaScript template strings must reach Bun unchanged.
# shellcheck disable=SC2016
BRIAR_VERSION="${BRIAR_VERSION:-unknown}" /opt/briar/bin/bun --eval '
  const fs = require("node:fs");
  const state = "/var/lib/briar";
  const config = JSON.parse(fs.readFileSync(`${state}/managed-enrollment.json`, "utf8"));
  const identityDocument = fs.readFileSync(`${state}/instance-identity.json`, "utf8");
  const identitySignature = fs.readFileSync(`${state}/instance-identity-signature`, "utf8");
  let response;
  try {
    response = await fetch(
      `${config.apiOrigin}/managed-computers/${config.managedComputerId}/enroll`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          nonce: config.nonce,
          identityDocument,
          identitySignature,
          briarVersion: process.env.BRIAR_VERSION ?? "unknown",
        }),
      },
    );
  } catch {
    console.error(
      "briar-managed-enroll: enrollment failed http_status=none error_code=NETWORK_REQUEST_FAILED",
    );
    process.exit(1);
  }

  const responseBody = await response.text();
  const safeErrorCode = () => {
    try {
      const parsed = JSON.parse(responseBody);
      const code = parsed && typeof parsed === "object" ? parsed.code : null;
      return typeof code === "string" && /^[A-Z][A-Z0-9_]{0,127}$/u.test(code)
        ? code
        : "UNKNOWN";
    } catch {
      return "UNKNOWN";
    }
  };

  if (!response.ok) {
    console.error(
      `briar-managed-enroll: enrollment failed http_status=${response.status} error_code=${safeErrorCode()}`,
    );
    process.exit(response.status === 409 ? 75 : 1);
  }

  let enrollment;
  try {
    enrollment = JSON.parse(responseBody);
  } catch {
    console.error(
      `briar-managed-enroll: enrollment failed http_status=${response.status} error_code=INVALID_SUCCESS_RESPONSE`,
    );
    process.exit(1);
  }
  fs.writeFileSync(`${state}/worker-credential.json`, JSON.stringify({
    ...enrollment,
    managedComputerId: config.managedComputerId,
    apiOrigin: config.apiOrigin,
  }), {
    mode: 0o600,
  });
'

chown root:briar "$credential_file"
chmod 0640 "$credential_file"
chmod 0750 "$state_dir"

rm -f "$config_file" "$identity_file" "$signature_file"
