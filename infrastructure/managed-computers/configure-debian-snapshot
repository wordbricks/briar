#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -u)" != "0" ]]; then
  echo "configure-debian-snapshot must run as root" >&2
  exit 1
fi

snapshot="${1:-}"
if [[ ! "$snapshot" =~ ^20[0-9]{6}T[0-9]{6}Z$ ]]; then
  echo "Debian snapshot must use YYYYMMDDTHHMMSSZ" >&2
  exit 1
fi

install -d -m 0755 /etc/apt/sources.list.d/briar-disabled
while IFS= read -r source; do
  name="$(basename -- "$source")"
  mv -- "$source" "/etc/apt/sources.list.d/briar-disabled/$name"
done < <(find /etc/apt/sources.list.d -maxdepth 1 -type f \
  \( -name '*.list' -o -name '*.sources' \) -print)

install -m 0644 /dev/null /etc/apt/sources.list
sources=/etc/apt/sources.list.d/briar-snapshot.list
{
  printf 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/%s/ trixie main contrib non-free non-free-firmware\n' "$snapshot"
  printf 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/%s/ trixie-updates main contrib non-free non-free-firmware\n' "$snapshot"
  printf 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/%s/ trixie-security main contrib non-free non-free-firmware\n' "$snapshot"
} > "$sources"
chmod 0644 "$sources"

cat > /etc/apt/apt.conf.d/99briar-snapshot <<'EOF'
Acquire::Check-Valid-Until "false";
Acquire::Retries "5";
APT::Install-Recommends "false";
EOF

apt-get update
