[Unit]
Description=Briar managed computer loopback remote desktop
After=network-online.target
Wants=network-online.target
After=briar-managed-enroll.service
Requires=briar-managed-enroll.service

[Service]
Type=simple
User=briar
Group=briar
Environment=HOME=/home/briar
Environment=GH_BROWSER=/opt/briar/bin/briar-open-browser
# The owner's own sign-ins on :1 feed the shared Computer Use login store.
Environment=BRIAR_BROWSER_PROFILE_DIRECTORY=/var/lib/briar-computer-use/profiles/display-1
Environment=BRIAR_REMOTE_DISPLAY_PORT=5901
Environment=BRIAR_REMOTE_DISPLAY_GEOMETRY=1280x720
Environment=BRIAR_REMOTE_DISPLAY_STARTUP_TIMEOUT_SECONDS=120
WorkingDirectory=/home/briar
ExecStartPre=/opt/briar/bin/verify-managed-admin
ExecStart=/opt/briar/bin/briar-remote-desktop
Restart=always
RestartSec=2
# Desktop terminals must inherit the owner's ability to use sudo.
NoNewPrivileges=false
