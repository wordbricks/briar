{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "briar-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "briar.wordbricks.ai/app*",
      "zone_name": "wordbricks.ai"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.svg"],
      "fallthrough": true
    },
    {
      "type": "Data",
      "globs": ["**/*.png"],
      "fallthrough": true
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/app",
      "/app/*",
      "/api/*",
      "/me",
      "/invitations*",
      "/organizations*",
      "/projects*",
      "/workers*",
      "/worker-claims",
      "/runs*",
      "/transcripts",
      "/issue-reply-claims*",
      "/agent-task-claims",
      "/agent-task-claims/*",
      "/channel-reply-claims*",
      "/queue*",
      "/run-events",
      "/health",
      "/github/*",
      "/slack/*",
      "/.well-known/*",
      "/open/*",
      "/releases/*",
      "/brand/*",
      "/device"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "briar-db",
      "database_id": "b83c9a2a-2a41-48ec-8bc4-ef038f5c9685",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHANNEL_REALTIME",
        "class_name": "ChannelRealtimeHub"
      }
    ]
  },
  "exports": {
    "ChannelRealtimeHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "briar-releases"
    },
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "briar-attachments"
    },
    {
      "binding": "ARCHIVES",
      "bucket_name": "briar-attachments"
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "17 */6 * * *"]
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "SLACK_CLIENT_ID",
      "SLACK_CLIENT_SECRET",
      "SLACK_SIGNING_SECRET",
      "SLACK_TOKEN_ENCRYPTION_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
