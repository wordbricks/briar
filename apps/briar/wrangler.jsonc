{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "briar-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "briar.wordbricks.ai/app*",
      "zone_name": "wordbricks.ai"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.svg"],
      "fallthrough": true
    },
    {
      "type": "Data",
      "globs": ["**/*.png"],
      "fallthrough": true
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "APNS_TEAM_ID": "QFJZ2V3829",
    "MANAGED_COMPUTER_AWS_REGION": "us-east-1",
    "MANAGED_COMPUTER_AWS_LAUNCH_TEMPLATE_ID": "lt-0bf7a358da7b03e93",
    "MANAGED_COMPUTER_AWS_LAUNCH_TEMPLATE_VERSION": "9",
    "MANAGED_COMPUTER_REMOTE_DESKTOP_ENABLED": "true"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      // TODO: Replace this manually synchronized allowlist with routing
      // derived from an Effect HTTP Router so new API routes cannot silently
      // fall through to static assets.
      "/app",
      "/app/*",
      "/api/*",
      "/briar.app.v1.*",
      "/briar.worker.v1.*",
      "/inbox/*",
      "/invitations*",
      "/organizations*",
      "/projects*",
      "/managed-computers*",
      "/worker-claims",
      "/runs*",
      "/issue-reply-claims*",
      "/agent-schedule-runs/claim",
      "/channel-reply-claims*",
      "/queue*",
      "/run-events",
      "/health",
      "/html-artifact-preview",
      "/github/*",
      "/slack/*",
      "/hooks/*",
      "/.well-known/*",
      "/open/*",
      "/releases/*",
      "/brand/*",
      "/device"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "briar-db",
      "database_id": "b83c9a2a-2a41-48ec-8bc4-ef038f5c9685",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHANNEL_REALTIME",
        "class_name": "ChannelRealtimeHub"
      },
      {
        "name": "CHANNEL_ACTIVITY_REALTIME",
        "class_name": "ChannelActivityHub"
      },
      {
        "name": "MANAGED_COMPUTER_REMOTE",
        "class_name": "ManagedComputerRemoteSessionHub"
      }
    ]
  },
  "workflows": [
    {
      "binding": "MANAGED_COMPUTER_PROVISIONING",
      "name": "briar-managed-computer-provisioning",
      "class_name": "ManagedComputerProvisioningWorkflow",
      "limits": {
        "steps": 500
      }
    }
  ],
  "exports": {
    "ChannelRealtimeHub": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ChannelActivityHub": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ManagedComputerRemoteSessionHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "briar-releases"
    },
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "briar-attachments"
    },
    {
      "binding": "ARCHIVES",
      "bucket_name": "briar-attachments"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["login@auth.wordbricks.ai"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "17 */6 * * *"]
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "SLACK_CLIENT_ID",
      "SLACK_CLIENT_SECRET",
      "SLACK_SIGNING_SECRET",
      "SLACK_TOKEN_ENCRYPTION_KEY",
      "MANAGED_COMPUTER_PROMOTION_CODE",
      "MANAGED_COMPUTER_ENROLLMENT_SECRET",
      "MANAGED_COMPUTER_AWS_ACCESS_KEY_ID",
      "MANAGED_COMPUTER_AWS_SECRET_ACCESS_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
