{
  "name": "@briar/app",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "briar": "src-cli/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "web:build": "bash ../../scripts/with-release-env.sh env VITE_BRIAR_WEB=true vite build",
    "build:release": "bash ../../scripts/with-release-env.sh vite build && bash ../../scripts/verify-release-config.sh",
    "lint": "oxlint . --config ../../.oxlintrc.jsonc",
    "lint:type-aware": "oxlint --type-aware . --config ../../.oxlintrc.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:d1:prepare && vitest run --exclude worker/src/migrations.test.ts --exclude worker/src/db.test.ts",
    "ios:native:project": "xcodegen generate --spec ios/BriarCompanion/project.yml --project ios/BriarCompanion",
    "ios:native:test": "bash ../../scripts/ios-simulator.sh test",
    "ios:release:verify": "bun run ../../scripts/ios-release-config.ts verify",
    "qa:release-updater": "bash ../../scripts/qa-production-updater-build.sh",
    "tauri": "tauri",
    "tauri:bindings": "cargo test --manifest-path src-tauri/Cargo.toml --lib ipc::tests::export_typescript_bindings -- --exact --ignored --nocapture",
    "tauri:build:release": "bash ../../scripts/with-release-env.sh bun run tauri build && bash ../../scripts/verify-release-config.sh",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --aab --ci",
    "android:build:debug": "tauri android build --debug --apk --target aarch64 --split-per-abi --ci",
    "cli:build": "bun build src-cli/index.ts --target=bun --outfile dist-cli/briar.js",
    "cli:install": "sh ../../scripts/install-cli.sh",
    "agent:build": "bun build src-agent/claude-runner.ts --target=bun --outfile dist-agent/claude-runner.js && bun build src-agent/cursor-runner.ts --target=bun --outfile dist-agent/cursor-runner.js && bun build src-agent/grok-runner.ts --target=bun --outfile dist-agent/grok-runner.js && bun build src-agent/agy-runner.ts --target=bun --outfile dist-agent/agy-runner.js && bun build src-agent/opencode-runner.ts --target=bun --outfile dist-agent/opencode-runner.js && bun build src-agent/codex-runner.ts --target=bun --outfile dist-agent/codex-runner.js && bun build src-cli/managed-computer-remote-session-agent.ts --target=bun --outfile dist-cli/briar-remote-session-agent.js",
    "runtime:prepare": "bun run ../../scripts/prepare-bun-sidecar.ts",
    "skills:generate": "bun run ../../scripts/generate-skill-guides.ts",
    "skills:check": "bun run ../../scripts/generate-skill-guides.ts --check",
    "d1:migrate:local": "wrangler d1 migrations apply briar-db --local",
    "d1:migrate:remote": "bun run ../../scripts/apply-remote-d1-migrations.ts",
    "test:d1:migrations": "bun run test:d1:prepare && vitest run worker/src/migrations.test.ts worker/src/db.test.ts worker/src/test-helpers/d1-template.test.ts",
    "test:d1:cache-recovery": "bun run test:d1:prepare && BRIAR_D1_TEST_CACHE_RECOVERY=1 vitest run --no-file-parallelism worker/src/test-helpers/d1-template.test.ts -t 'detects a corrupted cache entry'",
    "test:d1:integration": "bun run test:d1:prepare && vitest run --no-file-parallelism worker/src/test-helpers/d1-template.test.ts worker/src/agent-skill-execution-approval.test.ts worker/src/agent-worklog.test.ts worker/src/archive.test.ts worker/src/channel-agent-delegation.test.ts worker/src/channel-proposal-routes.test.ts worker/src/channels.test.ts worker/src/github-db.test.ts worker/src/github-integration-db.test.ts worker/src/inbox-realtime.test.ts worker/src/issue-execution-approval.test.ts worker/src/organization-agent-context.test.ts worker/src/project-agent-routes.test.ts worker/src/project-channel-messages.test.ts worker/src/slack-db.test.ts worker/src/workflow-policy.test.ts",
    "test:d1:prepare": "bun run ../../scripts/d1-test-template.ts",
    "test:d1:clean": "bun run ../../scripts/d1-test-template.ts --clean",
    "secrets:verify-encrypted": "bun run ../../scripts/verify-encrypted-env.ts",
    "secrets:check": "dotenvx run --strict --overload -f ../../.env.production -- bun run ../../scripts/with-worker-secrets.ts check",
    "worker:dev": "dotenvx run --strict --overload -f ../../.env.production -- bun run ../../scripts/with-worker-secrets.ts dev",
    "worker:types": "wrangler types worker-configuration.d.ts",
    "worker:check": "tsc --project worker/tsconfig.json",
    "worker:build": "wrangler deploy --dry-run --outdir dist-worker",
    "worker:deploy": "dotenvx run --strict --overload -f ../../.env.production -- bun run ../../scripts/with-worker-secrets.ts deploy",
    "worker:startup": "wrangler check startup"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@bufbuild/protobuf": "catalog:",
    "@briar/contracts": "workspace:*",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-web": "catalog:",
    "@effect/atom-react": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@novnc/novnc": "1.7.0",
    "@opencode-ai/sdk": "^1.3.15",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "catalog:",
    "emoji-mart": "^5.6.0",
    "lucide-react": "0.468.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "scheduler": "0.27.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@dotenvx/dotenvx": "catalog:",
    "@effect/eslint-plugin": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "catalog:",
    "@types/emoji-mart": "^5.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "27.4.0",
    "miniflare": "5.20260730.0-alpha",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
